# Copy to .env.local and fill in your values

# Site (optional; defaults to https://www.aayamfest.com from lib/site.ts)
NEXT_PUBLIC_SITE_URL=https://www.aayamfest.com

# Auth — JWT for admin & ambassador sessions (min 32 chars in production)
JWT_SECRET=your-secret-key-min-32-characters-long

# Firebase — from service account JSON (no JSON file in repo)
# Firebase Console → Project Settings → Service Accounts → Generate new key
# Copy project_id, client_email, private_key from the JSON. For private_key, use \n for newlines.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email — for ambassador approval & notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=AAYAM Ambassador Support <noreply@example.com>

# Admin seed (one-time) — create first admin via POST /api/admin/seed
ADMIN_SEED_SECRET=your-seed-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
